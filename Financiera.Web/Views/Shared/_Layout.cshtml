<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cooperativa El Progreso</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <nav class="sidebar">
            <div class="brand">
                <div class="brand-name">Coop. El Progreso</div>
                <div class="brand-sub">Cooperativa financiera</div>
            </div>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
               asp-controller="Home" asp-action="Index">Pantalla principal</a>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Associateds" ? "active" : "")"
               asp-controller="Associateds" asp-action="Index">Asociados</a>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Movements" ? "active" : "")"
               asp-controller="Movements" asp-action="Deposit">Movimientos</a>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
               asp-controller="Reports" asp-action="Index">Informes de gerencia</a>
        </nav>

        <main class="content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>