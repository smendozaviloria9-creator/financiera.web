@model MovementFormViewModel
@{
    ViewData["Title"] = "Registrar depósito";
}

<div class="page-title">Registrar depósito</div>
<div class="page-subtitle">Consignación a la cuenta de un asociado</div>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-action="Deposit" method="post" style="max-width: 500px;">
    <div class="mb-3">
        <label asp-for="DocumentNumber" class="form-label"></label>
        <input asp-for="DocumentNumber" class="form-control" />
        <span asp-validation-for="DocumentNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Valor de la consignación</label>
        <input asp-for="Amount" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-dark">Registrar consignación</button>
    <a asp-controller="Associateds" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>